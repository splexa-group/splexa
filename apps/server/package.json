{
  "name": "@splexa/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:html": "vitest run --reporter=html --outputFile=./html-report/index.html",
    "test:html:preview": "vite preview --outDir html-report",
    "clean": "rm -rf dist",
    "db:migrate": "prisma migrate dev",
    "db:migrate:staging": "ENV_FILE=.env prisma migrate deploy",
    "db:migrate:prod": "ENV_FILE=.env.production prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:status:staging": "ENV_FILE=.env.staging prisma migrate status",
    "db:migrate:status:prod": "ENV_FILE=.env.production prisma migrate status",
    "db:migrate:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:studio:staging": "ENV_FILE=.env.staging prisma studio",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@splexa-group/shared": "workspace:*",
    "@supabase/supabase-js": "^2.110.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.4.2",
    "fastify": "5.8.5",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.0.10",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
