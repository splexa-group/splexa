{
  "info": {
    "name": "Splexa API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Arjun\",\n  \"lastName\": \"Sharma\",\n  \"email\": \"arjun@example.com\",\n  \"phoneNumber\": \"+919876543210\",\n  \"designation\": \"ADVOCATE\",\n  \"orgName\": \"Sharma & Associates\",\n  \"practiceType\": \"CIVIL\",\n  \"city\": \"Delhi\"\n}"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"message\": \"OTP sent to your email\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/otp/request",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@example.com\"\n}"
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"message\": \"OTP sent\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/otp/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@example.com\",\n  \"otp\": \"123456\"\n}"
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"user\": {\n      \"id\": \"uuid\",\n      \"orgId\": \"uuid\",\n      \"firstName\": \"Arjun\",\n      \"lastName\": \"Sharma\",\n      \"email\": \"arjun@example.com\",\n      \"role\": \"OWNER\",\n      \"emailVerified\": true\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [],
            "description": "Reads refresh_token from cookie automatically"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"message\": \"Token refreshed\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "header": [],
            "description": "Reads refresh_token from cookie and revokes the session"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"message\": \"Logged out\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [],
            "description": "Requires access_token cookie (set after verify OTP)"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"orgId\": \"uuid\",\n    \"firstName\": \"Arjun\",\n    \"lastName\": \"Sharma\",\n    \"email\": \"arjun@example.com\",\n    \"phoneNumber\": \"+919876543210\",\n    \"designation\": \"ADVOCATE\",\n    \"role\": \"OWNER\",\n    \"emailVerified\": true,\n    \"org\": {\n      \"id\": \"uuid\",\n      \"name\": \"Sharma & Associates\",\n      \"practiceType\": \"CIVIL\",\n      \"city\": \"Delhi\"\n    }\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "List Sessions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/sessions",
            "header": [],
            "description": "Requires access_token cookie"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"sessions\": [\n      {\n        \"id\": \"uuid\",\n        \"ipAddress\": \"127.0.0.1\",\n        \"userAgent\": \"Mozilla/5.0\",\n        \"createdAt\": \"2026-05-16T10:00:00.000Z\",\n        \"lastUsedAt\": \"2026-05-16T12:00:00.000Z\"\n      }\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Requires access_token cookie",
            "url": {
              "raw": "{{baseUrl}}/auth/sessions/:id",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sessions", ":id"],
              "variable": [{ "key": "id", "value": "session-uuid-here" }]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"ipAddress\": \"127.0.0.1\",\n    \"userAgent\": \"Mozilla/5.0\",\n    \"createdAt\": \"2026-05-16T10:00:00.000Z\",\n    \"lastUsedAt\": \"2026-05-16T12:00:00.000Z\",\n    \"revokedAt\": null,\n    \"expiresAt\": \"2026-06-15T10:00:00.000Z\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Revoke Session",
          "request": {
            "method": "DELETE",
            "description": "Requires access_token cookie",
            "url": {
              "raw": "{{baseUrl}}/auth/sessions/:id",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "sessions", ":id"],
              "variable": [{ "key": "id", "value": "session-uuid-here" }]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"message\": \"Session revoked\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Revoke All Sessions",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/auth/sessions",
            "header": [],
            "description": "Requires access_token cookie. Clears cookies and revokes all sessions."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"message\": \"All sessions revoked\"\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Error Examples",
      "item": [
        {
          "name": "Invalid OTP",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/otp/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@example.com\",\n  \"otp\": \"000000\"\n}"
            }
          },
          "response": [
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"AUTH_INVALID_OTP\",\n    \"message\": \"Invalid OTP\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Validation Error",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/otp/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"otp\": \"12\"\n}"
            }
          },
          "response": [
            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"VALIDATION_ERROR\",\n    \"message\": \"Validation error\",\n    \"details\": []\n  }\n}"
            }
          ]
        }
      ]
    }
  ]
}
