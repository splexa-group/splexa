{
  "name": "@splexa-group/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./enums": {
      "types": "./src/enums/index.ts",
      "default": "./dist/enums/index.js"
    },
    "./models": {
      "types": "./src/models/index.ts",
      "default": "./dist/models/index.js"
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
